# Paperfect only ever reads your API key(s) from this file — the API base
# URL and model name are fixed in backend/core/config.py and cannot be
# changed here. Every *_API_KEY below accepts one key, or several
# comma-separated keys to round-robin across (helps with rate limits).
PARSE_API_KEY='sk-your_api_key_here'
CHAT_API_KEY='sk-your_api_key_here'
PAPER_API_KEY='sk-your_api_key_here'
ANNOTATOR_API_KEY='sk-your_api_key_here'
TRANSLATE_API_KEY='sk-your_api_key_here'
